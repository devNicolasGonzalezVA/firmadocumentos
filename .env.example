# Copia este archivo a .env y rellena los valores. .env NO se versiona.

# --- Modo de ejecución ---
# El código asume PRODUCCIÓN (modo estricto) salvo que esta variable diga lo
# contrario. En desarrollo, "development" habilita el tenant "local" (origins
# localhost) y el respaldo a EMAIL_TO cuando falta el correo de algún tenant.
# En App Runner: NODE_ENV=production (o simplemente no definirla).
NODE_ENV=development

PORT=3000

# --- Cuenta que ENVÍA los correos (Gmail + App Password) ---
EMAIL_USER=
EMAIL_PASS=

# --- Destinos por tenant ---
# Un correo por subdominio. El mapeo origin -> nombre de variable vive en
# config/tenants.json; el VALOR vive solo aquí (local) o en App Runner (prod).
# El nombre lo fija "emailToEnv" en el JSON; aquí van por cliente, no por
# subdominio. Si un tenant omite "emailToEnv", el nombre se deriva del id:
# TENANT_<ID>_EMAIL_TO (id en mayúsculas, guiones como "_").
# Cliente A -> the.documentosfirma.com
TENANT_A_EMAIL_TO=
# Cliente B -> this.documentosfirma.com
TENANT_B_EMAIL_TO=

# Destino del tenant "local" (dev). Fuera de producción también hace de
# respaldo cuando falta la variable de algún tenant.
EMAIL_TO=

# --- Límites de payload y firma ---
JSON_LIMIT=700kb
SIGNATURE_MAX_BYTES=250000
SIGNATURE_MIN_BYTES=2500

# --- Anti-spam ---
RATE_LIMIT_MAX=10
SLOWDOWN_AFTER=5
SLOWDOWN_DELAY_MS=800

# --- CORS ---
# Aditivo: los origins de config/tenants.json ya quedan permitidos.
ALLOWED_ORIGINS=

# Filtro anti-bot compartido (público: viaja en el JS del frontend).
SIGNATURE_TOKEN=
